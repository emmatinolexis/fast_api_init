# Stage 1: Build the image
FROM python:3.10-slim as build

# Set working directory
WORKDIR /mvtracking

# Copy requirements.txt and install dependencies
COPY ./requirements.txt /mvtracking/requirements.txt
RUN pip install --no-cache-dir --upgrade -r /mvtracking/requirements.txt

# Copy the rest of the application code
COPY ./app /mvtracking/app

# Stage 2: Final image
FROM python:3.10-slim

# Set working directory
WORKDIR /mvtracking

# Copy the built dependencies from the previous stage
COPY --from=build /mvtracking /mvtracking

# Run and expose the port
ENTRYPOINT ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
